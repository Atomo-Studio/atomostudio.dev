# GoHighLevel (GHL) - GoHealthy lead management integration
# Copy this file to .env and fill in real values. .env is gitignored — never commit real tokens.

# Private Integration Token from GHL: Settings > Private Integrations > Create New Integration
# Must start with "pit-". Grant only the scopes this integration actually needs (contacts, conversations, opportunities).
GHL_PIT_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sub-account (location) ID the agent should operate in
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

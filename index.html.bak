<footer style="border-top:1px solid rgba(255,255,255,0.04);padding:48px 0">
<div class="max-w-6xl mx-auto px-6 text-center">
<p class="text-xs" style="color:rgba(255,255,255,0.4)">© 2026 Átomo Studio. Todos los derechos reservados.</p></div></footer>

<div id="toast" style="position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(100px);background:linear-gradient(135deg,#1e3a5f,#2d1b69);color:#fff;padding:14px 28px;border-radius:14px;font-size:14px;z-index:999;display:flex;align-items:center;gap:10px;box-shadow:0 10px 40px rgba(0,0,0,0.5);transition:all .5s;opacity:0;border:1px solid rgba(59,130,246,0.15)"><i class="fas fa-check-circle" style="color:#34d399"></i><span id="toast-msg"></span></div>

<script>
function showToast(m){const t=document.getElementById('toast');document.getElementById('toast-msg').textContent=m;t.style.opacity='1';t.style.transform='translateX(-50%) translateY(0)';setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(-50%) translateY(100px)'},3000);}
const obs=new IntersectionObserver(e=>{e.forEach(e=>e.isIntersecting&&e.target.classList.add('visible'))},{threshold:.08});
document.querySelectorAll('.fade-up').forEach(e=>obs.observe(e));

// Hero particles
(function(){const c=document.getElementById('hero-particles');if(!c)return;const ctx=c.getContext('2d');let W,H;
function resize(){const hero=document.getElementById('inicio');W=c.width=hero.offsetWidth;H=c.height=hero.offsetHeight}
resize();window.addEventListener('resize',resize);
const p=[];for(let i=0;i<60;i++){p.push({x:Math.random()*2000,y:Math.random()*1200,vx:(Math.random()-0.5)*0.3,vy:(Math.random()-0.5)*0.3,r:1+Math.random()*1.5,a:0.04+Math.random()*0.08})}
function draw(){ctx.clearRect(0,0,W,H);p.forEach(pp=>{pp.x+=pp.vx;pp.y+=pp.vy;if(pp.x<0)pp.x=W;if(pp.x>W)pp.x=0;if(pp.y<0)pp.y=H;if(pp.y>H)pp.y=0;ctx.beginPath();ctx.arc(pp.x,pp.y,pp.r,0,Math.PI*2);ctx.fillStyle='#3b82f6';ctx.globalAlpha=pp.a;ctx.fill()});ctx.lineWidth=0.5;for(let i=0;i<p.length;i++){for(let j=i+1;j<p.length;j++){const dx=p[i].x-p[j].x,dy=p[i].y-p[j].y,d=Math.sqrt(dx*dx+dy*dy);if(d<140){ctx.beginPath();ctx.moveTo(p[i].x,p[i].y);ctx.lineTo(p[j].x,p[j].y);ctx.strokeStyle='#3b82f6';ctx.globalAlpha=0.015*(1-d/140);ctx.stroke()}}}ctx.globalAlpha=1;requestAnimationFrame(draw)}
if(!window.matchMedia('(prefers-reduced-motion:reduce)').matches)draw()})();

// Geo preview canvas
(function(){const c=document.getElementById('geo-preview');if(!c)return;const ctx=c.getContext('2d'),w=c.width,h=c.height;
const bg=ctx.createRadialGradient(w*0.4,h*0.35,0,w*0.5,h*0.5,w*0.7);bg.addColorStop(0,'#141425');bg.addColorStop(1,'#0a0a14');ctx.fillStyle=bg;ctx.fillRect(0,0,w,h);
ctx.strokeStyle='rgba(255,255,255,0.02)';ctx.lineWidth=0.5;for(let x=0;x<w;x+=20){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke()}
for(let y=0;y<h;y+=20){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke()}
const g=ctx.createRadialGradient(w*0.5,h*0.4,0,w*0.5,h*0.4,80);g.addColorStop(0,'rgba(59,130,246,0.2)');g.addColorStop(1,'transparent');ctx.fillStyle=g;ctx.fillRect(0,0,w,h);
function hex(hx,hy,hr,rot,a){ctx.beginPath();for(let i=0;i<6;i++){const ang=Math.PI/3*i+rot;const px=hx+hr*Math.cos(ang),py=hy+hr*Math.sin(ang);i===0?ctx.moveTo(px,py):ctx.lineTo(px,py)}ctx.closePath();ctx.strokeStyle='#3b82f6';ctx.globalAlpha=a;ctx.lineWidth=0.8;ctx.stroke();ctx.globalAlpha=1}
hex(w*0.8,h*0.2,22,0.2,0.08);hex(w*0.15,h*0.85,18,-0.3,0.06);hex(w*0.85,h*0.75,14,0.5,0.07);
ctx.font='800 48px Orbitron,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
const tg=ctx.createLinearGradient(w*0.3,0,w*0.7,0);tg.addColorStop(0,'#3b82f6');tg.addColorStop(1,'#8b5cf6');ctx.fillStyle=tg;
ctx.shadowColor='rgba(59,130,246,0.3)';ctx.shadowBlur=15;ctx.fillText('Geo',w*0.5,h*0.38);
ctx.shadowBlur=0;ctx.font='400 9px Inter,sans-serif';ctx.fillStyle='rgba(160,170,190,0.5)';ctx.fillText('MULTIAGENTE AI',w*0.5,h*0.54);
const lg=ctx.createLinearGradient(w*0.3,0,w*0.7,0);lg.addColorStop(0,'transparent');lg.addColorStop(0.5,'#3b82f6');lg.addColorStop(1,'transparent');
ctx.strokeStyle=lg;ctx.lineWidth=0.8;ctx.globalAlpha=0.3;ctx.beginPath();ctx.moveTo(w*0.25,h*0.6);ctx.lineTo(w*0.75,h*0.6);ctx.stroke();ctx.globalAlpha=1;
[[0.3,0.72],[0.45,0.78],[0.6,0.72],[0.7,0.8]].forEach(a=>{ctx.beginPath();ctx.arc(a[0]*w,a[1]*h,3,0,Math.PI*2);ctx.fillStyle='#3b82f6';ctx.globalAlpha=0.4;ctx.fill();ctx.globalAlpha=1})})();
</script>
</body>
</html>
